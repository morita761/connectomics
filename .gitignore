# 大きすぎて GitHub に載らないもの（fetch_data.py / run_all.py で作り直せる）
# （data/ そのものではなく中身を除外する。でないと下の !… が効かない）
data/*
# ドライバーの一覧と LexA のカタログは論文から手で起こしたもので作り直せないので追跡する
!data/driver_lines*.csv
!data/lexa_lines_nonmb.csv
!data/gmr_lexa_lines.txt
!data/vt_lexa_lines.txt
.venv/
__pycache__/
*.pyc

# データセット別の全ペア 3D（合計 3.5 GB）
results/*/3d/

# 解析の中間生成物（必要なら個別に許可する）
results/*/approach_*.csv
results/*/type_pairs_*.csv
results/*/candidates_ranked.csv
results/*/cross_*.csv
results/*/driver_*.csv
results/*/inspect_*.csv
results/*/index.html

# ノートブック・エディタ
.ipynb_checkpoints/
.vscode/
.idea/

# 公開用サイトは docs/ に置く（publish_site.py が生成。GitHub Pages のフォルダは / か /docs のみ）
# docs/ は追跡する。間違えて site/ を作ったときのために:
site/

# 解析の中間生成物（大きいので除外。run_all.py で作り直せる）
results/*/consensus.csv
